# ============================================================================
# secrets.example.env — NOMES dos secrets necessários no projeto
# karyuuhxeismshhxuokg. Nenhum valor real aqui. Preencha e use:
#   supabase secrets set --env-file .env.secrets --project-ref karyuuhxeismshhxuokg
# NUNCA versione o arquivo preenchido.
# ============================================================================

# ---------------------------------------------------------------------------
# FORNECIDOS AUTOMATICAMENTE PELO SUPABASE (não cadastrar, não sobrescrever)
#   SUPABASE_URL
#   SUPABASE_ANON_KEY
#   SUPABASE_SERVICE_ROLE_KEY
#   SUPABASE_DB_URL
# ---------------------------------------------------------------------------

# --- WhatsApp / Evolution API (obrigatório para todo o Atis) ---------------
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
ATIS_WEBHOOK_SECRET=

# --- Provedores de IA (fallback em cascata Groq -> xAI -> Gemini) ---------
GROQ_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY= # Necessário para TTS (Áudio da Bíblia)

# --- Web Push (VAPID) ------------------------------------------------------
# Reutilize EXATAMENTE o par atual, senão todas as inscrições push existentes
# são invalidadas e os usuários precisam reativar as notificações.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Outros serviços -------------------------------------------------------
YOUTUBE_API_KEY=

# --- URLs públicas do app --------------------------------------------------
APP_PUBLIC_URL=https://biblia.atalaias.online
APP_PUBLIC_ORIGIN=https://biblia.atalaias.online

# ---------------------------------------------------------------------------
# FRONTEND (Vercel -> Environment Variables, não são secrets de Edge Function)
#   VITE_SUPABASE_PROJECT_ID=karyuuhxeismshhxuokg
#   VITE_SUPABASE_URL=https://karyuuhxeismshhxuokg.supabase.co
#   VITE_SUPABASE_PUBLISHABLE_KEY=<publishable key do novo projeto>
#   VITE_SENTRY_DSN=<opcional>
# ---------------------------------------------------------------------------